# Ignore everything by default — this repo only tracks rice-relevant configs.
/*

# Rice-relevant configs
!/hypr
!/waybar
!/rofi
!/kitty
!/mako
!/quickshell
!/theme
!/btop
!/qt5ct
!/qt6ct
!/nwg-look
!/gtk-3.0
!/mimeapps.list
!/dolphinrc
!/Thunar
!/kdeglobals
!/sddm
!/.gitignore
!/README.md
!/install.sh

# Manual pre-git backups — superseded by git history
*.bak-*
/hypr/backups/

# Just a copy of hypr/wallpaper.png, refreshed by render.py's sync_sddm_theme() so the
# greeter (which can't read ~/.config) has its own copy - tracking it too would just
# double this repo's size with identical bytes.
/sddm/aether-rice/wallpaper.png

# Python bytecode cache (theme/presets.py imports theme/render.py as a module)
__pycache__/

