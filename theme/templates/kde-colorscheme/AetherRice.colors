# Generated by theme/render.py from the active palette.
# Edit the template at ~/.config/theme/templates/kde-colorscheme/AetherRice.colors, not
# the output.
#
# This is the piece kdeglobals's "ColorScheme=AetherRice" line was pointing at without it
# actually existing: KColorSchemeManager resolves a scheme *by name* to a file here, and
# Breeze (the widget style actually in use, regardless of qt6ct.conf saying "Fusion" - it
# gets loaded alongside qt6ct's style plugin) reads View/Selection colors through that
# lookup rather than through qt6ct's QPalette. Without this file, Breeze silently fell back
# to its own stock scheme - kdeglobals's inline [Colors:*] sections and qt6ct's palette
# were both being applied correctly, they just aren't what item-view selection uses.
[General]
Name=AetherRice
ColorScheme=AetherRice

[KDE]
contrast=4

[Colors:View]
BackgroundNormal={background.rgb}
BackgroundAlternate=32,33,44
ForegroundNormal={foreground.rgb}
ForegroundInactive={color8.rgb}
ForegroundActive={foreground.rgb}
ForegroundLink={color12.rgb}
ForegroundVisited={color5.rgb}
ForegroundNegative={color1.rgb}
ForegroundNeutral={color3.rgb}
ForegroundPositive={color2.rgb}
DecorationFocus={accent.rgb}
DecorationHover={color12.rgb}

[Colors:Window]
BackgroundNormal={background.rgb}
BackgroundAlternate=15,17,26
ForegroundNormal={foreground.rgb}
ForegroundInactive={color8.rgb}
ForegroundActive={foreground.rgb}
ForegroundLink={color12.rgb}
ForegroundVisited={color5.rgb}
ForegroundNegative={color1.rgb}
ForegroundNeutral={color3.rgb}
ForegroundPositive={color2.rgb}
DecorationFocus={accent.rgb}
