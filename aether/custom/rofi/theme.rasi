/* Generated by aether from the active palette.
   Edit the template at ~/.config/aether/custom/rofi/theme.rasi, not the output. */
* {
    bg:         rgba(15, 17, 26, 0.92);
    bg-alt:     {background.rgba:0.92};
    fg:         {foreground};
    muted:      {color8};
    accent:     {accent};
    accent-alt: {color12};
    urgent:     {color1};
}
